# Local dev overrides for ingestion-service
# For local runs (not compose), point Kafka to localhost
KAFKA_BOOTSTRAP=host.docker.internal:9092

# MinIO local endpoint (use localhost if running MinIO on host)
MINIO_ENDPOINT=host.docker.internal:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RAW=raw
